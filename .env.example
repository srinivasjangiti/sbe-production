# ==============================================================================
# Shree Balaji Enterprises — Environment Variables Configuration
# Copy this file to `.env.local` for local development.
# ==============================================================================

# Admin Authentication (Server-only credentials)
# Generate password hash with: node scripts/generate-admin-hash.mjs "your-strong-password"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="pbkdf2:250000:your_salt_hex_here:your_hash_hex_here"
SESSION_SECRET="your_random_64_character_hex_session_secret_here"

# ImageKit Integration (Used for property photo uploads in Admin panel)
# Sign up at https://imagekit.io to obtain your private key
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key_here"

# Distributed Rate Limiting (Upstash Redis)
# Highly recommended for Vercel / serverless deployments to share rate limits across lambda instances.
# If omitted, falls back to in-memory sliding-window rate limiting per serverless container.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Public Site Configuration (Default fallback is https://shreebalajienterprises.live)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
